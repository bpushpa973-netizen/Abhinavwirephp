# Railway MySQL plugin variables are injected automatically when linked:
# MYSQLHOST=...
# MYSQLPORT=...
# MYSQLDATABASE=...
# MYSQLUSER=...
# MYSQLPASSWORD=...

# Optional local-development equivalents:
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_NAME=abhinav_multipanel
# DB_USER=root
# DB_PASS=

# Required for signed API responses. Set RSA_PRIVATE_KEY (PEM with newlines)
# or RSA_PRIVATE_KEY_BASE64 (base64-encoded PEM) in Railway Variables.
# Never commit the private key or put it in client-side code.
# RSA_PRIVATE_KEY=

# Optional: set these in Railway Variables to create/reset the admin login securely.
# ADMIN_USERNAME=admin
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=use-a-unique-password-at-least-12-characters-long
